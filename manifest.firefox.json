{
  "manifest_version": 3,
  "name": "YouTube Cinema Mode",
  "version": "2.0.0",
  "description": "Hover over any YouTube thumbnail and press 'Space' to watch in a beautiful cinema overlay",
  "permissions": [
    "storage",
    "clipboardWrite",
    "cookies",
    "webRequest",
    "webRequestBlocking",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://*.youtube-nocookie.com/*",
    "https://youtube-nocookie.com/*"
  ],
  "background": {
    "scripts": [
      "background/background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content/modules/core.js",
        "content/modules/theme.js",
        "content/modules/icons.js",
        "content/modules/video.js",
        "content/modules/innertube.js",
        "content/modules/engagement.js",
        "content/modules/chapters.js",
        "content/modules/queue.js",
        "content/modules/layout.js",
        "content/modules/player.js",
        "content/modules/overlay.js",
        "content/modules/launcher.js",
        "content/modules/controls/toast.js",
        "content/modules/controls/autohide.js",
        "content/modules/controls/speed.js",
        "content/modules/controls/quality.js",
        "content/modules/controls/transport.js",
        "content/modules/controls/history.js",
        "content/modules/controls/ambient.js",
        "content/modules/controls/screenshot.js",
        "content/modules/controls/dock.js",
        "content/modules/controls/navigation.js",
        "content/modules/controls/engagement.js",
        "content/modules/controls/loop.js",
        "content/modules/controls/chapters.js",
        "content/modules/controls/queue.js",
        "content/modules/controls/filters.js",
        "content/modules/controls/zen.js",
        "content/modules/controls/keyboard.js",
        "content/modules/controller.js",
        "content/content.js"
      ],
      "css": [
        "content/styles/00-themes.css",
        "content/styles/01-overlay.css",
        "content/styles/02-ambient.css",
        "content/styles/03-docked.css",
        "content/styles/04-shorts.css",
        "content/styles/05-feedback.css",
        "content/styles/06-menus.css",
        "content/styles/07-page.css",
        "content/styles/08-engagement.css",
        "content/styles/09-loop-chapters.css",
        "content/styles/10-queue-filters.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-cinema": {
      "suggested_key": {
        "default": "Alt+H"
      },
      "description": "Toggle cinema mode for hovered video"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-cinema-mode@extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
